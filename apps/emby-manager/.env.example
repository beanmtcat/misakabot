DATABASE_URL=postgresql://user:password@postgres:5432/dragonli
EMBY_BASE_URL=https://emby.example/emby
# Public address used by links opened from the manager; API requests still use EMBY_BASE_URL.
EMBY_WEB_BASE_URL=https://emby.example
EMBY_API_KEY=replace-me
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=false
# Comma-separated Dragonli usernames allowed to access this admin panel.
EMBY_MANAGER_ADMIN_USERNAMES=htc10@qq.com
# Browser origin for the panel. It is required for login and every write request.
EMBY_MANAGER_ORIGIN=https://dashboard.example
EMBY_LOGIN_RATE_LIMIT_ATTEMPTS=5
EMBY_LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
EMBY_API_HOST=0.0.0.0
EMBY_API_PORT=8084
EMBY_USER_SYNC_INTERVAL_SECONDS=1800
# Emby movie metadata and media-source import, default: 30 minutes.
EMBY_MOVIE_SYNC_INTERVAL_SECONDS=1800
# Emby TV-series metadata import, default: 30 minutes.
EMBY_SERIES_SYNC_INTERVAL_SECONDS=1800
# Active Emby sessions are recorded as login logs every minute.
EMBY_LOGIN_SYNC_INTERVAL_SECONDS=60
EMBY_WATCH_SYNC_INTERVAL_SECONDS=60
# TMDB API Read Access Token. Required for official episode, per-episode and next-air-date tracking.
TMDB_API_TOKEN=
# 6 hours. TMDB tracking waits for this interval after service startup.
EMBY_TRACKING_SYNC_INTERVAL_SECONDS=21600
# Optional MoviePilot subscription import. Missing TV subscriptions are created as tracking placeholders.
MOVIEPILOT_BASE_URL=http://moviepilot:3000
MOVIEPILOT_API_TOKEN=
MOVIEPILOT_SYNC_INTERVAL_SECONDS=1800
# HMAC signing secret for the remotely called series-paths endpoint.
EMBY_PATH_MAP_API_SECRET=replace-with-a-long-random-secret
# Only needed outside Docker when the React build lives somewhere else.
# EMBY_WEB_ROOT=/absolute/path/to/emby-service/web/dist
